@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section with Background Image -->
<div class="text-center hero-background text-light rounded-3 mb-5 shadow-sm mt-4">
    <h1 class="display-4 fw-bold text-tan">Welcome to Sasquatch Snacks</h1>
    <p class="lead">Premium automated vending and commercial party equipment rentals serving Pierce County.</p>
    <p>Whether you need a quick snack on the go or a commercial popcorn machine for your next big event, we've got you covered.</p>
    <button class="btn btn-outline-light text-tan btn-lg mt-3" disabled="disabled">Explore Party Rentals (Coming Soon)</button>
</div>

<div class="row align-items-md-stretch text-center">
    <!-- Vending Side -->
    <div class="col-md-6 mb-4">
        <div class="h-100 p-5 bg-forest-dark text-light border-0 rounded-3 shadow-sm">
            <h2 class="text-tan">Automated Vending</h2>
            <p>Find our smart vending machines located throughout the area. Fully stocked with premium snacks, drinks, and daily essentials.</p>
            <!-- This will eventually link to a location map/list -->
            <button class="btn btn-outline-light text-tan" disabled="disabled">Find a Location (Coming Soon)</button>
        </div>
    </div>

    <!-- Rental Side -->
    <div class="col-md-6 mb-4">
        <div class="h-100 p-5 bg-forest-dark text-light border-0 rounded-3 shadow-sm">
            <h2 class="text-tan">Event Rentals</h2>
            <p>Take your party to the next level with our commercial-grade concession equipment.</p>
            <button class="btn btn-outline-light text-tan" disabled="disabled">Book Equipment (Coming Soon)</button>
        </div>
    </div>
</div>